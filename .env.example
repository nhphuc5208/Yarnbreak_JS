# Copy to .env and fill in (never commit .env).
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Passwords are stored as PBKDF2 hashes. Generate each one with:
#   python scripts/hash_password.py
# Accounts left without a hash are disabled (there is no default password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='pbkdf2_sha256$310000$<salt>$<hash>'
USER1_USERNAME=user1
USER1_PASSWORD_HASH=
USER2_USERNAME=user2
USER2_PASSWORD_HASH=

# Only needed if a front-end on another origin calls this API (comma-separated).
CORS_ORIGINS=
